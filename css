/* ============================================================
   Near-U - css/style.css
   Mobile-first CSS. Pehle chhote screen (360px), phir bade.
   Sections:
     1.  Root variables
     2.  Reset + base
     3.  Container
     4.  Buttons
     5.  Header (2 rows)
     6.  Hero
     7.  Search bar
     8.  Section common
     9.  Category grid
     10. Trending list + cards
     11. Skeleton
     12. Owner banner
     13. Footer
     14. Bottom nav
     15. Reveal animation
     16. Toast
     17. Modal
     18. Auth tabs
     19. Form fields
     20. Business modal extras
     21. Body modal open
     22. Categories panel (nu-cat)
     23. Icon helper (nu-ico)
     24. Biz links rows
     25. Social links
     26. Edit business + updates modal
     27. Language switcher (i18n)
     28. Google auth button + separator
     29. Forgot password link
     30. Delete account button
     31. Photo upload (form)
     32. Card photo (business card)
     33. Media queries
     34. Reduced motion
   ============================================================ */

/* ---------- 1. ROOT VARIABLES ---------- */
:root {
  --indigo: #2B2D6E;
  --indigo-dark: #1E2050;
  --orange: #FF6B2C;
  --orange-soft: #FFE9DE;
  --cream: #FFF9F3;
  --text: #1F2140;
  --muted: #6B6F8D;
  --whatsapp: #25D366;
  --white: #FFFFFF;
  --border: #EFE7DD;
  --error: #C0392B;
  --success: #1E8E4E;

  /* Radius */
  --r-16: 16px;
  --r-20: 20px;
  --r-24: 24px;

  /* Soft shadows */
  --shadow-sm: 0 2px 8px rgba(31, 33, 64, 0.06);
  --shadow-md: 0 6px 20px rgba(31, 33, 64, 0.09);
  --shadow-lg: 0 14px 34px rgba(31, 33, 64, 0.14);
}

/* ---------- 2. RESET + BASE ---------- */
* {
  box-sizing: border-box;
}

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.5;
  color: var(--text);
  background: var(--cream);
  overflow-x: hidden;
  /* Bottom nav ke liye jagah (app-style) */
  padding-bottom: 92px;
}

h1, h2, h3, h4 {
  font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  margin: 0;
  line-height: 1.25;
}

p {
  margin: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
  cursor: pointer;
}

img, svg {
  display: block;
  max-width: 100%;
}

/* Focus: sirf keyboard users ko orange outline dikhta hai */
:focus-visible {
  outline: 3px solid var(--orange);
  outline-offset: 2px;
  border-radius: 6px;
}

/* Screen reader ke liye chhupa text */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* [hidden] hamesha jeete */
[hidden] {
  display: none !important;
}

/* ---------- 3. CONTAINER (max width 1100px) ---------- */
.container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 16px;
}

/* ---------- 4. BUTTONS ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 48px;
  padding: 0 18px;
  border-radius: 999px;
  border: 2px solid transparent;
  font-family: inherit;
  font-size: 0.95rem;
  font-weight: 600;
  text-align: center;
  transition: background-color 0.18s ease, color 0.18s ease,
              border-color 0.18s ease, transform 0.18s ease,
              box-shadow 0.18s ease;
}

/* Important: hidden button display none ho */
.btn[hidden] {
  display: none;
}

/* Outline button: safed bg, indigo border */
.btn-outline {
  background: var(--white);
  color: var(--indigo);
  border-color: var(--indigo);
}

.btn-outline:hover {
  background: var(--indigo);
  color: var(--white);
}

.btn-outline:active {
  transform: scale(0.97);
}

/* Ghost button: transparent, indigo text */
.btn-ghost {
  background: transparent;
  color: var(--indigo);
  border-color: transparent;
  padding: 0 14px;
}

.btn-ghost:hover {
  background: var(--orange-soft);
}

.btn-ghost:active {
  transform: scale(0.97);
}

/* Orange search button */
.btn-search {
  background: var(--orange);
  color: var(--white);
  border-color: var(--orange);
}

.btn-search:hover {
  background: #E2551A;
  border-color: #E2551A;
}

.btn-search:active {
  transform: scale(0.97);
}

.btn-search:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* White button (owner banner ke liye) */
.btn-white {
  background: var(--white);
  color: var(--orange);
  border-color: var(--white);
}

.btn-white:hover {
  background: var(--orange-soft);
}

.btn-white:active {
  transform: scale(0.97);
}

/* Full width button */
.btn-block {
  width: 100%;
  display: flex;
}

/* Danger button (delete account ke liye) */
.btn-danger {
  background: #FBE9E7;
  color: var(--error);
  border-color: #FBE9E7;
}

.btn-danger:hover {
  background: var(--error);
  color: var(--white);
  border-color: var(--error);
}

.btn-danger:active {
  transform: scale(0.97);
}

.btn-danger:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* ---------- 5. HEADER (app-style: 2 rows) ---------- */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.94);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
  transition: box-shadow 0.22s ease;
}

.site-header.scrolled {
  box-shadow: var(--shadow-md);
}

.header-inner {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 8px 16px 4px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.logo {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-weight: 700;
  font-size: 1.3rem;
  letter-spacing: -0.02em;
  color: var(--indigo);
  white-space: nowrap;
}

.logo-u {
  color: var(--orange);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Chhota gol icon button (44x44 tap area, halka background) */
.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-width: 44px;
  height: 44px;
  padding: 0 12px;
  border: none;
  border-radius: 999px;
  background: var(--cream);
  color: var(--indigo);
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background-color 0.16s ease, transform 0.16s ease;
}

.icon-btn:hover {
  background: var(--orange-soft);
}

.icon-btn:active {
  transform: scale(0.96);
}

.icon-btn[hidden] {
  display: none !important;
}

/* Row 2: full-width search row */
.topbar-search {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 16px 10px;
}

/* ---------- 6. HERO ---------- */
.hero {
  position: relative;
  background: linear-gradient(140deg, var(--indigo) 0%, var(--indigo-dark) 100%);
  color: var(--white);
  border-bottom-left-radius: 28px;
  border-bottom-right-radius: 28px;
  overflow: hidden;
  scroll-margin-top: 132px;
  margin-bottom: 8px;
}

.hero-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.14;
  background: var(--orange);
  pointer-events: none;
}

.hero-circle-1 {
  width: 220px;
  height: 220px;
  top: -90px;
  right: -70px;
}

.hero-circle-2 {
  width: 140px;
  height: 140px;
  bottom: -70px;
  left: -50px;
  background: var(--white);
  opacity: 0.08;
}

.hero-circle-3 {
  width: 90px;
  height: 90px;
  top: 40px;
  left: 12%;
  background: var(--white);
  opacity: 0.06;
}

.hero-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 26px 16px 30px;
}

.hero-tagline {
  display: inline-block;
  background: var(--orange);
  color: var(--white);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 999px;
  margin-bottom: 12px;
}

.hero-title {
  font-size: 1.75rem;
  font-weight: 700;
  margin-bottom: 8px;
}

.hero-title .hl {
  color: var(--orange);
}

.hero-sub {
  font-size: 0.95rem;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 0;
  max-width: 460px;
}

/* ---------- 7. SEARCH BAR ---------- */
.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 4px 6px 4px 14px;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.search-bar:focus-within {
  border-color: var(--orange);
  box-shadow: 0 0 0 3px rgba(255, 107, 44, 0.2), var(--shadow-sm);
}

.search-icon {
  width: 20px;
  height: 20px;
  color: var(--muted);
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  background: transparent;
  font-family: inherit;
  font-size: 16px; /* iOS zoom rokne ke liye */
  color: var(--text);
  padding: 10px 0;
}

.search-input::placeholder {
  color: var(--muted);
}

/* Search row: search bar + Categories button */
.search-row {
  display: flex;
  align-items: stretch;
  flex-wrap: nowrap;
  gap: 8px;
  width: 100%;
}

.search-row .search-bar {
  flex: 1 1 auto;
  min-width: 0;
  max-width: none;
}

/* Categories button (orange primary) */
.nu-cat-open {
  flex: 0 0 auto;
  gap: 6px;
  padding: 0 12px;
  min-height: 44px;
  background: var(--orange);
  color: var(--white);
  border-color: var(--orange);
  font-size: 0.82rem;
  white-space: nowrap;
}

.nu-cat-open:hover {
  background: #E2551A;
  border-color: #E2551A;
}

.nu-cat-open:active {
  transform: scale(0.97);
}

.nu-cat-open-icon {
  width: 17px;
  height: 17px;
  flex-shrink: 0;
  stroke: currentColor;
  fill: none;
}

/* ---------- 8. SECTION COMMON ---------- */
.section {
  padding: 28px 0;
  scroll-margin-top: 132px;
}

.section-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--indigo);
  margin-bottom: 6px;
}

.section-sub {
  font-size: 0.9rem;
  color: var(--muted);
  margin-bottom: 18px;
}

/* ---------- 9. CATEGORY GRID ---------- */
.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  text-align: center;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--r-16);
  padding: 16px 10px;
  min-height: 118px;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.category-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-md);
}

.category-card:active {
  transform: scale(0.96);
}

.category-emoji {
  font-size: 1.9rem;
  line-height: 1;
}

.category-name {
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--indigo);
  line-height: 1.2;
}

.category-sub {
  font-size: 0.72rem;
  color: var(--muted);
  line-height: 1.2;
}

.more-wrap {
  display: flex;
  justify-content: center;
  margin-top: 18px;
}

/* ---------- 10. TRENDING LIST + CARDS ---------- */
.trending-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
}

.trending-card {
  background: var(--white);
  border-radius: 22px;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.trending-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

/* Card ka top: gradient + business naam ka pehla akshar */
.card-media {
  height: 118px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #EEF0FF 0%, var(--orange-soft) 100%);
  overflow: hidden;
}

/* Photo (agar business ne upload ki ho) */
.card-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  background: linear-gradient(135deg, #EEF0FF 0%, var(--orange-soft) 100%);
}

/* Pehla akshar: bada, indigo */
.card-initial {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 3rem;
  font-weight: 700;
  line-height: 1;
  color: var(--indigo);
  letter-spacing: -0.02em;
}

.card-body {
  padding: 14px 16px 16px;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 6px;
}

.card-name {
  font-size: 1.02rem;
  font-weight: 600;
  color: var(--indigo);
  line-height: 1.25;
}

.card-cat {
  font-size: 0.78rem;
  color: var(--muted);
  margin-top: 2px;
}

/* Verified badge: orange-soft pill */
.badge-verified {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: var(--orange-soft);
  color: #B8471A;
  font-size: 0.68rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 999px;
  white-space: nowrap;
}

.card-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 6px;
}

.card-area {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  color: var(--muted);
}

.rating-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: #FFF4E5;
  color: #B8471A;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 999px;
}

/* About: max 2 lines tak */
.card-about {
  font-size: 0.82rem;
  color: var(--muted);
  margin-top: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Call + WhatsApp buttons */
.card-actions {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.btn-call,
.btn-wa {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 48px;
  border-radius: 14px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--white);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.btn-call { background: var(--indigo); }
.btn-call:hover { opacity: 0.92; }
.btn-call:active { transform: scale(0.97); }

.btn-wa { background: var(--whatsapp); }
.btn-wa:hover { opacity: 0.92; }
.btn-wa:active { transform: scale(0.97); }

/* Poori Jaankari button (card ke neeche) */
.btn-view {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 48px;
  margin-top: 10px;
  border: 2px solid var(--indigo);
  border-radius: 14px;
  background: var(--white);
  color: var(--indigo);
  font-size: 0.9rem;
  font-weight: 600;
  transition: background-color 0.18s ease, color 0.18s ease, transform 0.16s ease;
}

.btn-view:hover {
  background: var(--indigo);
  color: var(--white);
}

.btn-view:active {
  transform: scale(0.97);
}

/* No results box */
.no-results {
  border: 2px dashed var(--border);
  background: var(--white);
  color: var(--muted);
  text-align: center;
  padding: 26px 16px;
  border-radius: var(--r-16);
  font-size: 0.92rem;
}

/* ---------- 11. SKELETON CARDS ---------- */
.skeleton-card {
  background: var(--white);
  border-radius: 22px;
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}

.skeleton-media {
  height: 118px;
  background: linear-gradient(90deg, #F2F0EC 25%, #E9E5DF 37%, #F2F0EC 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

.skeleton-body {
  padding: 14px 16px 16px;
}

.skeleton-line {
  height: 12px;
  border-radius: 6px;
  margin-bottom: 10px;
  background: linear-gradient(90deg, #F2F0EC 25%, #E9E5DF 37%, #F2F0EC 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

.skeleton-line.w-70 { width: 70%; }
.skeleton-line.w-40 { width: 40%; }
.skeleton-line.w-100 { width: 100%; }

.skeleton-btn-row {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.skeleton-btn {
  flex: 1;
  height: 48px;
  border-radius: 14px;
  background: linear-gradient(90deg, #F2F0EC 25%, #E9E5DF 37%, #F2F0EC 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

/* ---------- 12. OWNER BANNER ---------- */
.owner-banner {
  background: linear-gradient(135deg, var(--orange) 0%, #E2551A 100%);
  border-radius: var(--r-24);
  padding: 32px 20px;
  text-align: center;
  color: var(--white);
  box-shadow: var(--shadow-md);
}

.owner-title {
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 8px;
}

.owner-sub {
  font-size: 0.92rem;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 20px;
  max-width: 460px;
  margin-left: auto;
  margin-right: auto;
}

/* ---------- 13. FOOTER ---------- */
.site-footer {
  background: var(--indigo-dark);
  color: rgba(255, 255, 255, 0.82);
  text-align: center;
  padding: 30px 16px;
  margin-top: 20px;
}

.footer-logo {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--white);
  margin-bottom: 6px;
}

.footer-text {
  font-size: 0.88rem;
  margin-bottom: 12px;
}

.footer-copy {
  font-size: 0.76rem;
  color: rgba(255, 255, 255, 0.55);
}

/* ---------- 14. BOTTOM NAV ---------- */
.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 95;
  display: flex;
  background: var(--white);
  border-top: 1px solid var(--border);
  box-shadow: 0 -6px 20px rgba(31, 33, 64, 0.08);
  padding-bottom: env(safe-area-inset-bottom, 0);
}

.bottom-nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  background: transparent;
  border: none;
  padding: 8px 4px;
  min-height: 58px;
  font-family: inherit;
  font-size: 0.68rem;
  font-weight: 600;
  color: var(--muted);
  transition: color 0.18s ease, background-color 0.18s ease;
}

.bottom-nav-item .nu-ico {
  width: 22px;
  height: 22px;
  stroke: currentColor;
  fill: none;
}

.bottom-nav-item.active {
  color: var(--indigo);
}

.bottom-nav-item:active {
  opacity: 0.75;
}

/* ---------- 15. REVEAL (fade-up animation) ---------- */
.reveal {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity 0.55s ease, transform 0.55s ease;
}

.reveal.in-view {
  opacity: 1;
  transform: translateY(0);
}

/* ---------- 16. TOAST ---------- */
.toast {
  position: fixed;
  left: 50%;
  bottom: 96px;
  transform: translateX(-50%) translateY(12px);
  background: var(--indigo);
  color: var(--white);
  font-size: 0.88rem;
  font-weight: 500;
  padding: 12px 20px;
  border-radius: 999px;
  box-shadow: var(--shadow-lg);
  opacity: 0;
  pointer-events: none;
  z-index: 300;
  max-width: 90vw;
  text-align: center;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* ---------- 17. MODAL ---------- */
.modal {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.modal[hidden] {
  display: none;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(31, 33, 64, 0.55);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
}

.modal-card {
  position: relative;
  background: var(--white);
  border-radius: var(--r-24);
  width: 100%;
  max-width: 400px;
  padding: 24px;
  box-shadow: var(--shadow-lg);
  max-height: 90vh;
  overflow-y: auto;
  animation: modalPop 0.22s ease;
}

.modal-card-wide {
  max-width: 440px;
}

@keyframes modalPop {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 44px;
  height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 50%;
  background: var(--cream);
  color: var(--indigo);
  font-size: 1.5rem;
  line-height: 1;
  transition: background-color 0.16s ease;
}

.modal-close:hover {
  background: var(--orange-soft);
}

.modal-title {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--indigo);
  margin-bottom: 6px;
  padding-right: 40px;
}

.modal-sub {
  font-size: 0.86rem;
  color: var(--muted);
  margin-bottom: 14px;
}

/* ---------- 18. AUTH TABS ---------- */
.auth-tabs {
  display: flex;
  gap: 4px;
  background: var(--cream);
  border-radius: 999px;
  padding: 4px;
  margin-bottom: 16px;
}

.auth-tab {
  flex: 1;
  min-height: 42px;
  border: none;
  background: transparent;
  border-radius: 999px;
  font-family: inherit;
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--muted);
  transition: background-color 0.18s ease, color 0.18s ease;
}

.auth-tab.active {
  background: var(--orange);
  color: var(--white);
}

/* ---------- 19. FORM FIELDS ---------- */
.field-label {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text);
  margin-top: 12px;
  margin-bottom: 6px;
}

.field-input {
  width: 100%;
  min-height: 48px;
  border: 2px solid var(--border);
  border-radius: 14px;
  padding: 0 14px;
  font-family: inherit;
  font-size: 16px;
  color: var(--text);
  background: var(--white);
  outline: none;
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

.field-input:focus {
  border-color: var(--orange);
  box-shadow: 0 0 0 3px rgba(255, 107, 44, 0.15);
}

.field-input::placeholder {
  color: var(--muted);
}

.field-input.field-error {
  border-color: #C0392B;
}

.field-input.field-error:focus {
  border-color: #C0392B;
  box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.15);
}

.field-textarea {
  padding: 12px 14px;
  min-height: 90px;
  resize: vertical;
  line-height: 1.4;
}

select.field-input {
  appearance: none;
  -webkit-appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236B6F8D' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 12px center;
  background-size: 18px;
  padding-right: 40px;
  cursor: pointer;
}

.field-hint {
  font-size: 0.76rem;
  color: var(--muted);
  margin-top: 4px;
}

/* Password wrap */
.password-wrap {
  position: relative;
}

.toggle-password {
  position: absolute;
  top: 50%;
  right: 4px;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: var(--orange);
  padding: 0;
  border-radius: 50%;
  line-height: 1;
  transition: background-color 0.16s ease, opacity 0.16s ease;
}

.toggle-password:hover {
  background: var(--orange-soft);
}

.toggle-password:active {
  opacity: 0.7;
}

.eye-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--orange);
}

.eye-icon svg {
  width: 22px;
  height: 22px;
  stroke: currentColor;
  fill: none;
}

#authPassword {
  padding-right: 52px;
}

/* Auth message: error / success */
.auth-msg {
  font-size: 0.82rem;
  margin: 10px 0;
}

.auth-msg.error { color: var(--error); }
.auth-msg.success { color: var(--success); }

.account-email {
  font-weight: 600;
  color: var(--indigo);
  word-break: break-all;
  margin-bottom: 16px;
}

#adminAccountLink {
  margin-bottom: 10px;
}

/* ---------- 20. BUSINESS MODAL EXTRAS ---------- */
.done-emoji {
  text-align: center;
  margin: 0 0 10px;
}

.done-check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--orange);
  color: var(--white);
}

.done-check svg {
  width: 34px;
  height: 34px;
  stroke: currentColor;
  fill: none;
}

.done-text {
  text-align: center;
  font-size: 0.92rem;
  color: var(--text);
  margin: 8px 0;
}

.done-small {
  text-align: center;
  font-size: 0.8rem;
  color: var(--muted);
  margin: 4px 0 12px;
}

.biz-status-name {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--indigo);
  margin: 8px 0;
}

.status-pill {
  display: inline-block;
  font-size: 0.78rem;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: 999px;
  margin-bottom: 10px;
}

.status-pill.pending {
  background: var(--orange-soft);
  color: #B8471A;
}

.status-pill.published {
  background: #E4F6EC;
  color: var(--success);
}

.status-pill.rejected {
  background: #FBE9E7;
  color: var(--error);
}

.status-pill.suspended {
  background: #FBE9E7;
  color: var(--error);
}

/* ---------- 21. BODY MODAL OPEN (scroll lock) ---------- */
body.modal-open {
  overflow: hidden;
}

/* ============================================================
   22. NU-CAT (Categories panel)
   ============================================================ */

.nu-cat-panel {
  position: fixed;
  inset: 0;
  z-index: 250;
}

.nu-cat-overlay {
  position: absolute;
  inset: 0;
  background: rgba(31, 33, 64, 0.55);
  -webkit-backdrop-filter: blur(2px);
  backdrop-filter: blur(2px);
}

.nu-cat-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--white);
  border-top-left-radius: 24px;
  border-top-right-radius: 24px;
  box-shadow: 0 -10px 30px rgba(31, 33, 64, 0.2);
  padding: 14px 14px calc(18px + env(safe-area-inset-bottom, 0px));
  max-height: 78vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  animation: nuCatSheetUp 0.24s ease;
}

@keyframes nuCatSheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.nu-cat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
}

.nu-cat-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--indigo);
}

.nu-cat-close {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 50%;
  background: var(--cream);
  color: var(--indigo);
  font-size: 1.4rem;
  line-height: 1;
  transition: background-color 0.16s ease;
}

.nu-cat-close:hover {
  background: var(--orange-soft);
}

.nu-cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.nu-cat-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 58px;
  padding: 8px 6px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--cream);
  color: var(--indigo);
  font-family: inherit;
  font-size: 0.8rem;
  font-weight: 600;
  line-height: 1.25;
  transition: background-color 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
}

.nu-cat-tile:hover {
  background: var(--orange-soft);
  border-color: var(--orange);
}

.nu-cat-tile:active {
  transform: scale(0.97);
}

.nu-cat-tile.active {
  background: var(--orange);
  border-color: var(--orange);
  color: var(--white);
}

.nu-cat-tile-name {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-word;
}

/* Trending heading + "Sab dikhao" */
.nu-cat-trending-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
}

.nu-cat-clear {
  flex-shrink: 0;
  min-height: 38px;
  padding: 0 14px;
  border-radius: 999px;
  border: 2px solid var(--indigo);
  background: var(--white);
  color: var(--indigo);
  font-family: inherit;
  font-size: 0.8rem;
  font-weight: 600;
  white-space: nowrap;
  transition: background-color 0.18s ease, color 0.18s ease, transform 0.16s ease;
}

.nu-cat-clear:hover {
  background: var(--indigo);
  color: var(--white);
}

.nu-cat-clear:active {
  transform: scale(0.97);
}

body.nu-cat-lock {
  overflow: hidden;
}

/* Desktop popover (768px+) */
@media (min-width: 768px) {
  .nu-cat-overlay {
    background: rgba(31, 33, 64, 0.16);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .nu-cat-sheet {
    left: 0;
    right: auto;
    bottom: auto;
    top: 0;
    width: 460px;
    max-width: calc(100vw - 32px);
    max-height: 64vh;
    border-radius: var(--r-16);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    padding: 14px;
    animation: nuCatPop 0.16s ease;
  }

  @keyframes nuCatPop {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }

  .nu-cat-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .nu-cat-tile {
    min-height: 62px;
  }
}

/* ============================================================
   23. NU-ICO (icon helper)
   ============================================================ */
.nu-ico {
  width: 1.05em;
  height: 1.05em;
  flex-shrink: 0;
