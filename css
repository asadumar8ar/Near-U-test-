/* ============================================================
   30. DELETE ACCOUNT BUTTON (uses .btn-danger, extra spacing)
   ============================================================ */
#deleteAccountBtn {
  margin-top: 10px;
}

/* ============================================================
   31. PHOTO UPLOAD (Add/Edit Business form)
   ============================================================ */
.biz-photo-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 8px;
}

.biz-photo-preview {
  width: 72px;
  height: 72px;
  flex: 0 0 auto;
  border-radius: 14px;
  border: 2px dashed var(--border);
  background: var(--cream);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: var(--muted);
  font-size: 0.68rem;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
  cursor: pointer;
  transition: border-color 0.16s ease, background-color 0.16s ease;
}

.biz-photo-preview:hover {
  border-color: var(--muted);
  background: #FFFFFF;
}

.biz-photo-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.biz-photo-actions {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.biz-photo-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36px;
  padding: 0 14px;
  border: 2px solid var(--border);
  border-radius: 999px;
  background: var(--white);
  color: var(--indigo);
  font-family: inherit;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.16s ease, border-color 0.16s ease;
}

.biz-photo-btn:hover {
  background: var(--cream);
  border-color: var(--muted);
}

.biz-photo-btn:active {
  transform: scale(0.98);
}

.biz-photo-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.biz-photo-status {
  font-size: 0.74rem;
  color: var(--muted);
  min-height: 14px;
  margin: 0;
}

.biz-photo-status.error { color: var(--error); }
.biz-photo-status.success { color: var(--success); }

/* ============================================================
   32. CARD PHOTO (business card image)
   ============================================================ */
.card-media img.card-photo {
  width: 100%;
  height: 118px;
  object-fit: cover;
  display: block;
  background: linear-gradient(135deg, #EEF0FF 0%, var(--orange-soft) 100%);
}

/* ============================================================
   33. MEDIA QUERIES
   ============================================================ */

/* ----- Tablet: 640px se upar ----- */
@media (min-width: 640px) {
  .hero-inner {
    padding: 34px 16px 38px;
  }

  .hero-title {
    font-size: 2.1rem;
  }

  .hero-sub {
    font-size: 1rem;
  }

  .category-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .trending-list {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .section {
    padding: 36px 0;
  }

  .section-title {
    font-size: 1.5rem;
  }

  .owner-banner {
    padding: 44px 32px;
  }

  .owner-title {
    font-size: 1.6rem;
  }

  .modal-card {
    padding: 28px;
  }
}

/* ----- Desktop: 980px se upar ----- */
@media (min-width: 980px) {
  .hero-inner {
    padding: 42px 16px 46px;
  }

  .hero-title {
    font-size: 2.5rem;
  }

  .trending-list {
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .section {
    padding: 44px 0;
  }

  .section-title {
    font-size: 1.65rem;
  }

  .owner-banner {
    padding: 56px 40px;
  }

  .owner-title {
    font-size: 1.85rem;
  }
}

/* ----- Floating bottom bar (tablet/desktop 769px+) ----- */
@media (min-width: 769px) {
  body {
    padding-bottom: 112px;
  }

  .bottom-nav {
    left: 50%;
    right: auto;
    transform: translateX(-50%);
    bottom: 16px;
    width: 100%;
    max-width: 520px;
    border-radius: 20px;
    border: 1px solid var(--border);
    box-shadow: 0 10px 26px rgba(31, 33, 64, 0.16);
    padding-bottom: 0;
  }

  .bottom-nav-item {
    min-height: 54px;
  }

  .toast {
    bottom: 100px;
  }
}

/* ----- Chhoti screen (max 400px) ----- */
@media (max-width: 400px) {
  .search-row {
    gap: 6px;
  }

  .search-row .search-bar {
    gap: 6px;
    padding-left: 12px;
  }

  .search-row .search-icon {
    width: 18px;
    height: 18px;
  }

  .search-row .btn-search {
    padding: 0 12px;
    font-size: 0.85rem;
  }

  .nu-cat-open {
    gap: 5px;
    padding: 0 10px;
    font-size: 0.78rem;
  }

  .nu-cat-open-icon {
    width: 16px;
    height: 16px;
  }

  .nu-lang .lang-btn {
    font-size: 0.62rem;
    padding: 5px 7px;
    min-height: 28px;
  }

  .updates-list {
    gap: 10px;
    margin-bottom: 16px;
  }

  .updates-list li {
    font-size: 0.88rem;
    padding-left: 26px;
  }

  .updates-list li::before {
    width: 16px;
    height: 16px;
    top: 3px;
  }

  .updates-list li::after {
    left: 5.5px;
    top: 6.5px;
    width: 4px;
    height: 7px;
  }
}

/* ============================================================
   34. REDUCED MOTION
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }

  .reveal {
    opacity: 1 !important;
    transform: none !important;
  }
}
